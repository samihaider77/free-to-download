{
  "manifest_version": 3,
  "key": "",
  "name": "Free-to-Download",
  "version": "0.6.5",
  "description": "Send links and direct media URLs to your local Free-to-Download app.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "webRequest", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Free-to-Download",
             "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["video-overlay.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }],
  "options_page": "options.html"
}
